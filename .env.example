# ============================================================
# Built-in channels (preferred)
# ============================================================
# PM_WEBHOOK_URL        -> "pm-jobs":          entry-level PM / APM / TPM roles
# FULL_TIME_WEBHOOK_URL -> "swe-ai-full-time": new-grad / entry-level SWE, AI, ML, data
# Keyword, exclusion, and location defaults live in config.py.
# (SWE_WEBHOOK_URL / the internship channel was retired on 2026-09-04 and is ignored.)
PM_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_PM_WEBHOOK_ID/YOUR_TOKEN
FULL_TIME_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_FULLTIME_WEBHOOK_ID/YOUR_TOKEN

# Advanced: JSON list of channels to ADD, or to OVERRIDE a built-in channel by
# reusing its name. See channels.json.example for the shape.
CHANNELS_JSON=

# Optional local file path for multi-channel config.
CHANNELS_PATH=channels.json

# ============================================================
# Single-channel fallback (only used when no channel above is set)
# ============================================================
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN

# Single-channel filters (defaults = the full-time channel's lists in config.py).
# Comma-separated, whole-word, case-insensitive.
KEYWORDS=
EXCLUDED_KEYWORDS=
# Positive locations (blank = all locations). Foreign locations in
# EXCLUDED_LOCATIONS veto a match unless a concrete US location also appears.
LOCATIONS=
EXCLUDED_LOCATIONS=

# ============================================================
# Run behaviour
# ============================================================

# Max Discord notifications per run per channel. Extra matches are queued and
# flushed on later runs that have nothing new.
MAX_NOTIFICATIONS_PER_RUN=25

# Only notify jobs whose posted_at is within this window. Sources that only
# know the posting *date* get an extra day of grace. 0 disables the filter.
RECENT_POSTING_MAX_AGE_HOURS=24

# ATS boards fetched concurrently, pause between boards, per-request timeout.
ATS_CONCURRENCY=8
SLEEP_BETWEEN_COMPANIES=0.5
REQUEST_TIMEOUT=25
REQUEST_RETRY_ATTEMPTS=2

# Send a "no new jobs" summary embed every run. Leave false: with ~96 runs/day
# this is pure channel noise.
SEND_NO_NEW_SUMMARY=false

# ============================================================
# Sources (all optional — blank = defaults in config.py)
# ============================================================

# SimplifyJobs-format listings.json repos (SimplifyJobs + vanshb03). Update the
# year when a new cycle starts. Do NOT list renamed 2026 repos alongside the
# 2027 ones: GitHub serves both names and the 12 MB file gets fetched twice.
SIMPLIFY_URLS=

# Markdown-table README repos.
SPEEDYAPPLY_URLS=
JOBRIGHT_URLS=
ZAPPLY_URLS=

# JSON new-grad trackers: "name=url,name=url" (names must have a spec in
# scrapers/json_sources.py). "none" disables.
JSON_SOURCE_URLS=

# amazon.jobs search queries (comma-separated).
AMAZON_QUERIES=

# Workday tenants "tenant:wdN:site:Label,..." and search queries. "none" disables.
WORKDAY_TENANTS=
WORKDAY_QUERIES=
WORKDAY_PAGES=2

# Max top-level comments to fetch from the monthly HN "Who is Hiring?" thread.
HN_MAX_COMMENTS=500
